{
  "name": "awana-label-printer",
  "version": "9.4.3",
  "description": "KVBC Awana: the print server and the screens, one app for every KVBC Awana computer",
  "main": "main.js",
  "scripts": {
    "predev": "node ../../scripts/family-assets.mjs printer",
    "dev": "electron .",
    "pretest": "node ../../scripts/family-assets.mjs printer",
    "test": "node --test \"test/*.test.cjs\"",
    "prebuild:renderer": "node ../../scripts/family-assets.mjs printer",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "build": "npm run build:renderer && electron-builder --win --x64",
    "dist": "npm run build:renderer && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.kvbc.awana-label-printer",
    "productName": "KVBC Awana",
    "publish": {
      "provider": "generic",
      "url": "https://awana.kvbchurch.org/updates/printer/"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "KVBC-Awana-Setup.exe",
      "shortcutName": "KVBC Awana"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "!src/**/*.test.*",
      "static/**",
      "dist/**",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../print-server",
        "to": "print-server",
        "filter": [
          "*.js",
          "server/**",
          "church-config.json",
          "package.json",
          "public/**"
        ]
      },
      {
        "from": "../print-server/node_modules",
        "to": "print-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../",
        "to": "./",
        "filter": [
          "changes.md"
        ]
      },
      {
        "from": "../chrome-extension",
        "to": "chrome-extension",
        "filter": [
          "*.js",
          "*.json",
          "*.html",
          "*.png",
          "*.md"
        ]
      }
    ]
  }
}
