{
  "name": "check-in-label-generator",
  "private": true,
  "version": "9.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "node ../scripts/family-assets.mjs printer",
    "reel": "node ../scripts/family-assets.mjs printer && node reel/make.mjs",
    "test:contracts": "node scripts/test-contracts.cjs",
    "test:replay": "node scripts/test-replay-night.cjs",
    "test:server": "node scripts/test-server-helpers.cjs",
    "test:security": "node scripts/test-server-security.cjs",
    "test:demo": "node scripts/test-server-demo.cjs",
    "test:connect": "node scripts/test-connect-card.cjs",
    "test:templates": "node scripts/test-label-templates.cjs",
    "test:golden": "node scripts/test-label-golden.cjs",
    "test:golden:update": "UPDATE_LABEL_BASELINES=1 node scripts/test-label-golden.cjs",
    "pretest": "node ../scripts/family-assets.mjs printer",
    "test": "node scripts/run-tests.cjs",
    "test:serial": "npm run pretest && node scripts/run-tests.cjs --serial",
    "test:extension": "node scripts/test-extension-identity.cjs && node scripts/test-extension-checkin.cjs && node scripts/test-extension-queue.cjs",
    "test:extension-sync": "node scripts/test-extension-sync.cjs",
    "test:config-store": "node scripts/test-config-store.cjs",
    "test:envelope": "node scripts/test-envelope.cjs",
    "test:cloud-crypto": "node scripts/test-cloud-crypto.cjs",
    "test:station-keys": "node scripts/test-station-keys.cjs",
    "test:job-puller": "node scripts/test-job-puller.cjs",
    "test:cloud-e2e": "node scripts/test-cloud-e2e.cjs",
    "test:station-greeting": "node scripts/test-station-greeting.cjs",
    "test:church-sync": "node scripts/test-church-sync.cjs",
    "test:realtime": "node scripts/test-server-realtime.cjs",
    "test:slides": "node scripts/test-lobby-slides.cjs",
    "test:settings": "node scripts/test-display-settings.cjs",
    "test:settings-page": "node scripts/test-settings-page.cjs",
    "test:leaders": "node scripts/test-leaders.cjs",
    "test:custom": "node scripts/test-custom-label.cjs",
    "test:tonight": "node scripts/test-tonight-count.cjs",
    "test:tonight-shared": "node scripts/test-tonight-shared.cjs",
    "test:pickup": "node scripts/test-pickup-board.cjs",
    "gen:envelope-fixture": "node scripts/gen-envelope-fixture.cjs",
    "test:checkout": "node scripts/test-checkout-parser.cjs",
    "test:reconcile": "node scripts/test-reconcile.cjs",
    "test:audit": "node scripts/test-attendance-audit.cjs",
    "test:brand": "node scripts/test-brand-kit.cjs",
    "test:club-fonts": "node scripts/test-club-fonts.cjs",
    "test:about": "node scripts/test-about-page.cjs",
    "test:dashboard": "node scripts/test-dashboard-chrome.cjs",
    "test:app": "node --test \"electron-app/test/*.test.cjs\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
