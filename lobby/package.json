{
  "name": "awana-check-in-display",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Joyful digital signage welcome screen for Awana club check-ins. Not affiliated with or endorsed by Awana Clubs International.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p jsconfig.json",
    "e2e": "playwright test --project=smoke",
    "e2e:visual": "playwright test --project=visual",
    "e2e:events": "playwright test --project=events",
    "e2e:update": "playwright test --project=visual --update-snapshots",
    "e2e:build": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.2.7",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/oswald": "^5.2.8",
    "@fontsource/lilita-one": "^5.2.8",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.5.4",
    "jszip": "^3.10.1",
    "pusher-js": "^8.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^5.4.8",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
